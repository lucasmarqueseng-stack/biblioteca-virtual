# Copie este arquivo para `.env` antes de rodar o projeto:
#   cp .env.example .env        (Linux/macOS)
#   copy .env.example .env      (Windows cmd)
#   Copy-Item .env.example .env (Windows PowerShell)
#
# Para desenvolvimento local, o SQLite abaixo já funciona sem nenhuma configuração extra.
# Para produção (Vercel + Neon, por exemplo), troque pelo URL do Postgres:
#   DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

DATABASE_URL="file:./dev.db"
